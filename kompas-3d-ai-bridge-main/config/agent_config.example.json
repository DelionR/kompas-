    "max_rotation_steps_per_call": 12
  },
  "kompas": {
    "version_matrix": {
      "entries": [],
      "default_level": "unverified",
      "guarded_actions": [],
      "notes": "Формат записи: {\"pattern\": \"25.*\", \"level\": \"certified|targeted|experimental|unsupported\", \"notes\": \"...\"}. Пустая матрица означает «не проверено», а не «поддерживается». Действия из guarded_actions блокируются, пока версия не попадёт в certified или targeted."
    }
  },
  "safety": {
    "protected_roots": [
      "C:\\KOMPAS_AI_WORKSPACE\\00_SOURCE",
      "C:\\KOMPAS_AI_WORKSPACE\\01_CURRENT_CDW",
      "C:\\KOMPAS_AI_WORKSPACE\\02_3D_V9_STABLE"
    ],
    "write_roots": [
      "{bridge_root}\\work",
      "C:\\KOMPAS_AI_WORKSPACE\\90_OUTPUT"
    ],
    "jobs_subdir": "jobs"
  }
}
