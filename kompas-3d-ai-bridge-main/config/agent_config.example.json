{
  "bridge_version": "1.1.14_CAP2",
  "protocol_version": "1.1.11",
  "kompas_progid": "KOMPAS.Application.7",
  "api5_progid": "KOMPAS.Application.5",
  "worker_poll_ms": 120,
  "mcp_tool_timeout_sec": 90,
  "job_timeout_max_sec": 300,
  "compact_threshold_bytes": 60000,
  "compact_max_items": 200,
  "viewport": {
    "capture_method": "api7_document_frame_imagegrab_with_printwindow_fallback",
    "crop": {
      "left": 345,
      "top": 160,
      "right": 8,
      "bottom": 10
    },
