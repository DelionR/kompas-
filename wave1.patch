+
+# Версии протокола MCP, которые этот сервер умеет обслуживать.
+# 2025-06-18 - версия, на которой проект был выпущен (structured output,
+#              elicitation, resource links).
+# 2025-11-25 - актуальная стабильная (иконки, incremental consent,
+#              URL-mode elicitation, экспериментальные Tasks).
+# Порядок важен: последняя запись считается версией по умолчанию.
+SUPPORTED_PROTOCOL_VERSIONS: Tuple[str, ...] = ("2025-06-18", "2025-11-25")
+MCP_PROTOCOL_VERSION = SUPPORTED_PROTOCOL_VERSIONS[-1]
+
+
+def negotiate_protocol(client_version: str | None) -> str:
+    """Выбрать версию протокола для ответа на ``initialize``.
+
+    Раньше сервер всегда отвечал захардкоженной строкой и игнорировал то,
+    что запросил клиент. По спецификации сервер обязан ответить либо
+    запрошенной версией, если он её поддерживает, либо своей максимальной -
+    и тогда клиент сам решает, продолжать ли работу.
+    """
+    if client_version and client_version in SUPPORTED_PROTOCOL_VERSIONS:
+        return client_version
+    return MCP_PROTOCOL_VERSION
+
