+def tool_names() -> List[str]:
+    """Имена инструментов в стабильном порядке каталога."""
+    return [t["name"] for t in TOOLS]
+
+
+def catalog_snapshot() -> Dict[str, Any]:
+    """Компактный снимок поверхности для контрактного теста и VERSION.json."""
+    return {
+        "server_name": SERVER_NAME,
+        "server_version": SERVER_VERSION,
+        "protocol_version": MCP_PROTOCOL_VERSION,
+        "supported_protocol_versions": list(SUPPORTED_PROTOCOL_VERSIONS),
+        "mcp_tool_count": len(TOOLS),
+        "mcp_tools": tool_names(),
+    }
+
+
+def routing_table() -> Dict[str, Tuple[str, Callable[[Dict[str, Any]], Dict[str, Any]]]]:
+    """Полная таблица маршрутизации, включая инструменты обёртки."""
+    table: Dict[str, Tuple[str, Callable[[Dict[str, Any]], Dict[str, Any]]]] = dict(ACTION_MAP)
+    for name, action in WRAPPER_SIDE_ACTIONS.items():
+        table[name] = (action, lambda a: a)
+    return table
