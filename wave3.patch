 import ctypes, csv, io, subprocess, time
 from ctypes import wintypes
 
+from dialogs import DIALOG_CLASS
+
 USER32 = ctypes.windll.user32
 
 
@@ -168,6 +170,74 @@ def find_kompas_window(min_width=300, min_height=200):
